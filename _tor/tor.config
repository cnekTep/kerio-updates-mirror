# ─── Network ──────────────────────────────────────────────────────────────────

SocksPort 0.0.0.0:9050

# ─── Bridges & Transports ─────────────────────────────────────────────────────

ClientTransportPlugin obfs4,webtunnel exec /usr/bin/lyrebird
UseBridges 1
%include /tor/bridges/user_bridges.config
%include /tor/bridges/bridges.config

# ─── Exit Policy ──────────────────────────────────────────────────────────────

ExcludeExitNodes {ru},{by}     # Exclude some region exit nodes
StrictNodes 1                  # Enforce ExcludeExitNodes strictly

# ─── Circuit Behavior ─────────────────────────────────────────────────────────

NewCircuitPeriod 30            # Rotate circuits every 30s (default: 30)
MaxCircuitDirtiness 600        # Max circuit age in seconds (default: 600)
CircuitBuildTimeout 10         # Fail slow circuits faster (default: 60)
LearnCircuitBuildTimeout 0     # Disable adaptive timeout (more predictable)

# ─── Connection ───────────────────────────────────────────────────────────────

ConnectionPadding 1            # Enable padding to resist traffic analysis
ReducedConnectionPadding 0

# ─── Data ─────────────────────────────────────────────────────────────────────

DataDirectory /var/lib/tor
PIDFile       /var/lib/tor/tor.pid

# ─── Logging ──────────────────────────────────────────────────────────────────

Log notice stdout              # Only important messages - no debug noise
